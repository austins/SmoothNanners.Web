@model PortalCard

<section class="portal-card @Model.Accent.ToString().ToLowerInvariant()">
    <h2>
        <icon svg-icon="Model.HeadingIcon"/>
        @Model.HeadingText
    </h2>

    @* Preserve list semantics in Safari when list-style is none. *@
    <ul role="list">
        @Model.ChildContent
    </ul>

    @if (!Model.IsSlotContentNullOrEmpty(PortalCard.ExtrasSlot))
    {
        <div class="extras">
            @Model.RenderSlot(PortalCard.ExtrasSlot)
        </div>
    }
</section>
