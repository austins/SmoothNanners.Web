@page
@model Index

@section Hero {
    <div id="bio">
        <img
            src="~/images/avatar.webp"
            asp-append-version="true"
            width="200"
            height="200"
            alt="@AppConstants.SiteName"
            decoding="async"
            loading="eager"
        />

        <div>
            <p>Howdy! I'm Austin.</p>
            <p>I'm a gamer, musician, software engineer, and photographer. Find my streams, videos, code, and socials below.</p>
        </div>
    </div>
}

