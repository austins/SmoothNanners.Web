{
    "$schema": "http://json.schemastore.org/libman.json",
    "version": "3.0",
    "defaultDestination": "./wwwroot/vendor",
    "defaultProvider": "jsdelivr",
    "libraries": [
        {
            "library": "alpinejs@3.17.4",
            "files": [
                "dist/cdn.min.js"
            ],
            "destination": "./wwwroot/vendor/alpinejs"
        },
        {
            "library": "@fontsource-variable/recursive@5.3.0",
            "files": [
                "files/recursive-latin-full-normal.woff2"
            ],
            "destination": "./wwwroot/vendor/recursive"
        }
    ]
}
